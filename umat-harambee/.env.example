# This project's core "Navigate with Google Maps" feature works with NO API
# key — it opens Google's public Directions URL in a new tab/app.
#
# The variable below is only needed if you later choose to embed an
# interactive Google Map (e.g. via @react-google-maps/api) instead of, or in
# addition to, the "open in Google Maps" links. Never commit a real key.
VITE_GOOGLE_MAPS_API_KEY=
